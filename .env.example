# LLM provider: openai | anthropic | mock (offline, rules-based; for tests and demos only)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Policy retrieval: chroma (OpenAI embeddings) | tfidf (offline)
RETRIEVER=chroma
EMBEDDING_MODEL=text-embedding-3-small

# Risk model: xgboost | logreg
RISK_MODEL_TYPE=xgboost

# Agent limits
AGENT_MAX_STEPS=4
AGENT_MAX_CALLS_PER_STEP=6
TOOL_TIMEOUT_S=15
TOOL_RETRIES=2

# Optional: endpoint from the fraud-typology-extractor project, e.g. http://localhost:8000
TYPOLOGY_API_URL=

# Optional tracing with LangSmith
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=fraud-investigation-agent
